<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.interviewkb.mapper.UserMapper">

    <resultMap id="UserWithRolesMap" type="com.interviewkb.entity.User">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="email" column="email"/>
        <result property="password" column="password"/>
        <result property="nickname" column="nickname"/>
        <result property="avatar" column="avatar"/>
        <result property="phone" column="phone"/>
        <result property="gender" column="gender"/>
        <result property="bio" column="bio"/>
        <result property="status" column="status"/>
        <result property="emailVerified" column="email_verified"/>
        <result property="lastLoginTime" column="last_login_time"/>
        <result property="lastLoginIp" column="last_login_ip"/>
        <result property="loginCount" column="login_count"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <collection property="roles" ofType="com.interviewkb.entity.Role">
            <id property="id" column="role_id"/>
            <result property="roleName" column="role_name"/>
            <result property="roleCode" column="role_code"/>
        </collection>
    </resultMap>

    <select id="selectByUsernameWithRoles" resultMap="UserWithRolesMap">
        SELECT u.*, r.id as role_id, r.role_name, r.role_code
        FROM sys_user u
        LEFT JOIN sys_user_role ur ON u.id = ur.user_id
        LEFT JOIN sys_role r ON ur.role_id = r.id
        WHERE u.username = #{username} AND u.deleted = 0
    </select>

    <select id="selectByIdWithRoles" resultMap="UserWithRolesMap">
        SELECT u.*, r.id as role_id, r.role_name, r.role_code
        FROM sys_user u
        LEFT JOIN sys_user_role ur ON u.id = ur.user_id
        LEFT JOIN sys_role r ON ur.role_id = r.id
        WHERE u.id = #{id} AND u.deleted = 0
    </select>

    <select id="selectByEmail" resultType="com.interviewkb.entity.User">
        SELECT * FROM sys_user WHERE email = #{email} AND deleted = 0
    </select>
</mapper>
